{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aura-notes-pwa",
  "main": "src/worker.ts",
  "compatibility_date": "2024-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Required so /auth/freebuff/* reaches the Worker instead of the SPA fallback.
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "vars": {
    // Canonical origin, used as the Sign in with Freebuff baseUrl.
    "APP_ORIGIN": "https://aura-notes-pwa.gazarxperia.workers.dev",
    "FREEBUFF_CLIENT_ID": "548d02e3-9df4-4a70-963a-640a4b6474de"
  },
  "kv_namespaces": [
    {
      "binding": "AURA_SYNC_KV",
      "id": "344c61c31f594381bfeaa78d990d3dd2"
    }
  ]
}
